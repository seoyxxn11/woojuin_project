{
  "manifest_version": 3,
  "key": "",
  "name": "우주인 원클릭 스크랩",
  "version": "0.3.0",
  "description": "지금 보는 페이지를 우주인에 빠르게 저장합니다.",
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "우주인에 저장",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://api.dev.woojuin.store/*",
    "https://api.woojuin.store/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "https://dev.woojuin.store/*",
      "https://woojuin.store/*"
    ]
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
